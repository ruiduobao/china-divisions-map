        // ===== 左右拖动条 - 参考 verticalResizer，修复 iframe 事件捕获问题 =====
let isResizing = false;
const resizer = document.getElementById('resizer');
const leftPanel = document.getElementById('provinceData');
const mainContainer = document.querySelector('.main-container');
const frameOverlay = document.getElementById('frameOverlay');

if (resizer && leftPanel && mainContainer) {
    // 鼠标按下
    resizer.addEventListener('mousedown', (event) => {
        isResizing = true;
        event.preventDefault();
        
        // 显示覆盖层，阻止 iframe 捕获鼠标事件
        if (frameOverlay) {
            frameOverlay.style.display = 'block';
            frameOverlay.style.position = 'fixed';
            frameOverlay.style.top = '0';
            frameOverlay.style.left = '0';
            frameOverlay.style.right = '0';
            frameOverlay.style.bottom = '0';
            frameOverlay.style.zIndex = '9999';
            frameOverlay.style.cursor = 'col-resize';
        }
        
        // 禁止选中文本
        document.body.style.userSelect = 'none';
    });
    
    // 鼠标移动
    document.addEventListener('mousemove', (event) => {
        if (!isResizing) return;
        
        const containerRect = mainContainer.getBoundingClientRect();
        let newWidth = event.clientX - containerRect.left;
        
        // 约束宽度
        const minWidth = 200;
        const maxWidth = containerRect.width * 0.85;
        newWidth = Math.max(minWidth, Math.min(maxWidth, newWidth));
        
        leftPanel.style.width = newWidth + 'px';
    });
    
    // 鼠标释放
    document.addEventListener('mouseup', () => {
        if (!isResizing) return;
        isResizing = false;
        
        // 隐藏覆盖层
        if (frameOverlay) {
            frameOverlay.style.display = 'none';
        }
        
        // 恢复文本选择
        document.body.style.userSelect = '';
    });
    
    // 触摸支持
    resizer.addEventListener('touchstart', (event) => {
        isResizing = true;
        event.preventDefault();
        
        if (frameOverlay) {
            frameOverlay.style.display = 'block';
            frameOverlay.style.position = 'fixed';
            frameOverlay.style.top = '0';
            frameOverlay.style.left = '0';
            frameOverlay.style.right = '0';
            frameOverlay.style.bottom = '0';
            frameOverlay.style.zIndex = '9999';
        }
    }, { passive: false });
    
    document.addEventListener('touchmove', (event) => {
        if (!isResizing) return;
        const touch = event.touches[0];
        
        const containerRect = mainContainer.getBoundingClientRect();
        let newWidth = touch.clientX - containerRect.left;
        
        const minWidth = 200;
        const maxWidth = containerRect.width * 0.85;
        newWidth = Math.max(minWidth, Math.min(maxWidth, newWidth));
        
        leftPanel.style.width = newWidth + 'px';
    }, { passive: false });
    
    document.addEventListener('touchend', () => {
        if (!isResizing) return;
        isResizing = false;
        
        if (frameOverlay) {
            frameOverlay.style.display = 'none';
        }
    });
}
        
        // ===== 上下拖动条 =====
        let isVerticalResizing = false;
        const verticalResizer = document.getElementById('verticalResizer');
        const mapContainerEl = document.getElementById('mapContainer');
        const selectProvinceEl = document.getElementById('SELECT_province');
        const selectAndMapEl = document.getElementById('SELECT_AND_MAP');
        
        // 鼠标事件
        if (verticalResizer) {
            verticalResizer.addEventListener('mousedown', (event) => {
                isVerticalResizing = true;
                event.preventDefault();
            });
            
            document.addEventListener('mousemove', (event) => {
                if (!isVerticalResizing) return;
                
                const containerRect = selectAndMapEl.getBoundingClientRect();
                const mapHeight = event.clientY - containerRect.top;
                const selectHeight = containerRect.height - mapHeight - 5; // 5是拖动条高度
                
                // 约束最小高度
                if (mapHeight >= 100 && selectHeight >= 80) {
                    mapContainerEl.style.flex = `0 0 ${mapHeight}px`;
                    selectProvinceEl.style.flex = `0 0 ${selectHeight}px`;
                }
            });
            
            document.addEventListener('mouseup', () => {
                isVerticalResizing = false;
            });
            
            // 触摸支持
            verticalResizer.addEventListener('touchstart', (event) => {
                isVerticalResizing = true;
                event.preventDefault();
            }, { passive: false });
            
            document.addEventListener('touchmove', (event) => {
                if (!isVerticalResizing) return;
                const touch = event.touches[0];
                
                const containerRect = selectAndMapEl.getBoundingClientRect();
                const mapHeight = touch.clientY - containerRect.top;
                const selectHeight = containerRect.height - mapHeight - 5;
                
                if (mapHeight >= 100 && selectHeight >= 80) {
                    mapContainerEl.style.flex = `0 0 ${mapHeight}px`;
                    selectProvinceEl.style.flex = `0 0 ${selectHeight}px`;
                }
            }, { passive: false });
            
            document.addEventListener('touchend', () => {
                isVerticalResizing = false;
            });
        }
        

