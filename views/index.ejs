        // 高德显示点矢量
        function loadGeoPointJSONfromPath(filepath) {
                    map.clearMap();  // 清除地图上的所有覆盖物
                    fetch(filepath)
                        .then(response => response.json())
                        .then(geojsonData => {
                            const geojson = new AMap.GeoJSON({
                                geoJSON: geojsonData,
                                getMarker: function(geojson, lnglats) {
                                    // 创建一个红色的标记
                                    return new AMap.Marker({
                                        position: lnglats,
                                        icon: new AMap.Icon({
                                            size: new AMap.Size(40, 50),  // 图标尺寸
                                            image: "https://webapi.amap.com/theme/v1.3/markers/n/mark_r.png"  // 红色标记的图标URL
                                        })
                                    });
                                }
                            });
                            geojson.setMap(map);
                            
                            // 根据GeoJSON覆盖物自动调整地图视野
                            map.setFitView();

                        })
                        .catch(error => {
                            console.error('Error loading GeoJSON data to the map:', error);
                        });
                }

        //高德显示面矢量
        function loadGeoJSONfromPath(filepath) {
            map.clearMap();
            // 添加时间戳避免缓存
            const url = filepath + '?t=' + Date.now();
            fetch(url)
                .then(response => response.json())
                .then(geojsonData => {
                    const geojson = new AMap.GeoJSON({
                        geoJSON: geojsonData,
                        getPolygon: function(geojson, lnglats) {
                            return new AMap.Polygon({
                                path: lnglats,
                                strokeColor: '#ff33cc',
                                fillColor: '#ffc3a0',
                                fillOpacity: 0  // 空心实线，内部无填充
                            });
                        }
                    });
                    geojson.setMap(map);
                    
                    // 根据GeoJSON覆盖物自动调整地图视野
                    map.setFitView();

                })
                .catch(error => {
                    console.error('Error loading GeoJSON data to the map:', error);
                });
        }

        //是否展示下载按钮函数
        function checkAndShowDownloadButton(dataCode) {
            const formatSelect = document.getElementById('formatSelect');
            const downloadDIV_DIV = document.getElementById('downloadDIV');
            formatSelect.style.display = 'flex';
            downloadDIV_DIV.style.display='block';
            
            // 更新选中信息显示
            updateSelectedInfo(dataCode);
            
            // 显示/隐藏批量下载选项（县级和地级市显示）
            const batchDiv = document.getElementById('batchDownload');
            const batchTitle = document.getElementById('batchDownloadTitle');
            const countyOptions = document.getElementById('countyBatchOptions');
            const cityOptions = document.getElementById('cityBatchOptions');
            
            if (batchDiv) {
                // 判断是县级还是地级市
                // 地级市：6位且后2位为00（如 440100），或4位编码（如 4401）
                const isCounty = dataCode && dataCode.length === 6 && !dataCode.endsWith('00');
                const isCity = dataCode && (
                    (dataCode.length === 6 && dataCode.endsWith('00') && !dataCode.endsWith('0000')) ||
                    dataCode.length === 4
                );
                const isTown = dataCode && dataCode.length === 12 && dataCode.endsWith('000');
                const villageModeRow = document.getElementById('villageModeRow');

                if (isCounty) {
                    batchDiv.style.display = 'block';
                    batchTitle.textContent = '📦 批量下载县级（含下级）：';
                    countyOptions.style.display = 'block';
                    cityOptions.style.display = 'none';
                    if (villageModeRow) villageModeRow.style.display = 'block';
                } else if (isCity) {
                    batchDiv.style.display = 'block';
                    batchTitle.textContent = '📦 批量下载地级市（含下级）：';
                    countyOptions.style.display = 'none';
                    cityOptions.style.display = 'block';
                    if (villageModeRow) villageModeRow.style.display = 'block';
                } else if (isTown) {
                    batchDiv.style.display = 'block';
                    batchTitle.textContent = '📦 批量下载乡镇级（含下级）：';
                    countyOptions.style.display = 'none';
                    cityOptions.style.display = 'none';
                    if (villageModeRow) villageModeRow.style.display = 'block';
                } else {
                    batchDiv.style.display = 'none';
                    if (villageModeRow) villageModeRow.style.display = 'none';
                }
            }
        }
        
        // 统一批量下载函数（支持县级、地级市和乡镇）
        async function downloadBatch() {
            const code = dataCode;
            if (!code) {
                alert('请先选择一个区域');
                return;
            }
            
            // 获取当前选择的格式
            const selectedFormatItem = document.querySelector('#formatSelect li.selected');
            const format = selectedFormatItem ? selectedFormatItem.getAttribute('data-value') : 'shp';
            
            // 判断是县级、地级市还是乡镇
            const isCounty = code.length === 6 && !code.endsWith('00');
            const isCity = (code.length === 6 && code.endsWith('00') && !code.endsWith('0000')) || code.length === 4;
            const isTown = code.length === 12 && code.endsWith('000');
            
            if (!isCounty && !isCity && !isTown) {
                alert('请先选择一个县级、地级市或乡镇区域');
                return;
            }
            
            // 获取当前选择的年份
            const yearSelect = document.getElementById('year');
            const year = yearSelect ? yearSelect.value.replace('年', '') : '2023';
            
            // 对于地级市，如果是4位编码，需要补全为6位
            const cityCode = isCity && code.length === 4 ? code + '00' : code;
            
            // 显示加载动画
            showLoading('正在打包数据，请稍候...');
            
            try {
                // 先检查下载状态
                const statusResponse = await fetch('/checkDownloadStatus');
                const status = await statusResponse.json();
                
                if (status.isBanned) {
                    hideLoading();
                    const banEndTime = new Date(status.banEndTime);
                    const now = new Date();
                    const remainingMinutes = Math.ceil((banEndTime - now) / 60000);
                    document.getElementById('banCountdown').textContent = `解封时间：${remainingMinutes}分钟后`;
                    showBanModal();
                    return;
                }
                
                if (status.needPassword) {
                    hideLoading();
                    showPasswordModal();
                    return;
                }
                
                // 根据类型选择不同的API
                // 村级下载模式选择：默认 point_plus_xiang（点+乡镇），用户可改
                const villageModeSel = document.getElementById('villageDownloadMode');
                const downloadCunChk = document.getElementById('downloadCun');
                let villageParam;
                if (isTown) {
                    // 乡镇级：不显示村级复选框，直接用选中的模式
                    villageParam = villageModeSel ? villageModeSel.value : 'point_plus_xiang';
                } else {
                    // 县级/市级：根据村级复选框决定
                    const includeCun = downloadCunChk ? downloadCunChk.checked : true;
                    if (!includeCun) {
                        villageParam = 'none';
                    } else {
                        villageParam = villageModeSel ? villageModeSel.value : 'point_plus_xiang';
                    }
                }

                let downloadUrl;
                if (isCounty) {
                    downloadUrl = `/downloadCountyBatch/county/${code}?format=${format}&year=${year}&village=${villageParam}`;
                } else if (isCity) {
                    downloadUrl = `/downloadCityBatch/city/${cityCode}?format=${format}&year=${year}&village=${villageParam}`;
                } else if (isTown) {
                    downloadUrl = `/downloadTownBatch/town/${code}?format=${format}&year=${year}&village=${villageParam}`;
                }
                
                const response = await fetch(downloadUrl);
                
                if (!response.ok) {
                    throw new Error('下载失败: ' + response.status);
                }
                
                // 获取文件名
                const contentDisposition = response.headers.get('Content-Disposition');
                let filename = isCounty ? `县级批量数据_${code}.zip` : `地级市批量数据_${cityCode}.zip`;
                if (contentDisposition) {
                    const utf8Match = contentDisposition.match(/filename\*=UTF-8''([^;]+)/);
                    if (utf8Match) {
                        filename = decodeURIComponent(utf8Match[1]);
                    } else {
                        const match = contentDisposition.match(/filename="?([^";]+)"?/);
                        if (match) filename = match[1];
                    }
                }
                
                // 转换为 blob 并下载
                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                document.body.removeChild(a);
                
                // 下载完成，隐藏加载动画
                hideLoading();
                
            } catch (error) {
                hideLoading();
                console.error('批量下载失败:', error);
                alert('批量下载失败: ' + error.message);
            }
        }
        
        // 保留旧函数名以兼容
        async function downloadCountyBatch(format) {
            return downloadBatch(format);
        }
        
        // 显示加载动画
        function showLoading(message) {
            const loading = document.getElementById('loading');
            // 先移除旧的提示文字
            const oldText = loading.querySelector('.loading-text');
            if (oldText) oldText.remove();
            
            // 添加新的提示文字
            const loader = loading.querySelector('.loader');
            if (loader) {
                loader.insertAdjacentHTML('afterend', `<div class="loading-text" style="margin-top: 16px; color: #718096;">${message}</div>`);
            }
            loading.style.display = 'flex';
        }
        
        // 隐藏加载动画
        function hideLoading() {
            const loading = document.getElementById('loading');
            loading.style.display = 'none';
            const text = loading.querySelector('.loading-text');
            if (text) text.remove();
        }
        
        // 更新选中信息
        function updateSelectedInfo(code) {
            const nameEl = document.getElementById('selectedName');
            const codeEl = document.getElementById('selectedCode');
            if (nameEl && codeEl) {
                // 从全局变量获取名称，优先使用 address（地名）
                // 如果 address 为空或是编码格式，则显示编码
                let displayName = address;
                if (!displayName || /^\d+$/.test(displayName)) {
                    // 如果 address 为空或全是数字，尝试从 GeoJSON 获取名称
                    displayName = code;  // 回退到编码
                }
                nameEl.textContent = displayName;
                codeEl.textContent = code ? `(${code})` : '';
            }
        }
        
        // 必应搜索地区名称
        function searchRegionName() {
            const nameEl = document.getElementById('selectedName');
            const name = nameEl.textContent;
            if (name && name !== '-') {
                const url = `https://cn.bing.com/search?q=${encodeURIComponent(name)}`;
                window.open(url, '_blank');
            }
        }
        
        // 复制选中信息
        function copySelectedInfo(btn) {
            const nameEl = document.getElementById('selectedName');
            const codeEl = document.getElementById('selectedCode');
            const name = nameEl.textContent;
            const code = codeEl.textContent.replace(/[()]/g, '');
            const text = `${name}\t${code}`;
            
            navigator.clipboard.writeText(text).then(() => {
                // 复制成功后，字体颜色变为黑色
                nameEl.style.color = '#000';
                codeEl.style.color = '#000';
                
                // 显示复制成功提示
                const originalText = btn.textContent;
                btn.textContent = '✓ 已复制';
                btn.style.background = '#e6f7ff';
                setTimeout(() => {
                    btn.textContent = originalText;
                    btn.style.background = 'white';
                }, 1500);
            }).catch(err => {
                alert('复制失败: ' + err);
            });
        }

