        });

        // 必应卫星 (quadkey 方式)
        let BINGLAYER = new AMap.TileLayer({
            getTileUrl: function(x, y, z) {
                let quadKey = '';
                for (let i = z; i > 0; i--) {
                    let digit = 0;
                    let mask = 1 << (i - 1);
                    if ((x & mask) !== 0) digit++;
                    if ((y & mask) !== 0) digit += 2;
                    quadKey += digit;
                }
                return 'https://ecn.t3.tiles.virtualearth.net/tiles/a' + quadKey + '.jpeg?g=1';
            },
            tileSize: 256,
            zIndex: 100
        });

