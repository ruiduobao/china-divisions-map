                                        type: 'expandToCounty',
                                        countyCode: code,
                                        countyName: name,
                                        shengCode: shengCode,
                                        shiCode: shiCode
                                    }, '*');
                                }
                            }, 500);
                        };
                    } else {
                        // 直接发送消息展开到该县
                        if (iframe && iframe.contentWindow) {
                            iframe.contentWindow.postMessage({
                                type: 'expandToCounty',
                                countyCode: code,
                                countyName: name,
                                shengCode: shengCode,
                                shiCode: shiCode
                            }, '*');
                        }
                    }
