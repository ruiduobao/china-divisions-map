    <script>
        //设置dataCode和address为全局变量
        let dataCode;
        let address;
        //iframe为全局变量
        let iframe
        // 在这个函数的最开始声明Year和Province
        let Year, Province; 
        //选中格式为全局变量
        let selectedFormat; 
        // 从全局变量或其他地方获取dataCode和address
        let id ;  
        //下载链接为全局变量
        let downloadUrl;  
        //从首页选中的省份代码为全局变量
        let SHENG_datacode;
        // 当页面加载完毕时执行，加载动画
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(function() {
                document.getElementById('loading').style.display = 'none';
            }, 1000);
            
            // 移动端：点击左侧面板外部区域关闭面板
            document.addEventListener('click', function(e) {
                const panel = document.getElementById('provinceData');
                const btn = document.getElementById('mobileMenuBtn');
                if (window.innerWidth <= 599 && 
                    panel && panel.classList.contains('show') && 
                    !panel.contains(e.target) && 
                    !btn.contains(e.target)) {
                    panel.classList.remove('show');
                }
            });
        });

        // 移动端菜单切换
        function toggleMobileMenu() {
            const panel = document.getElementById('provinceData');
            if (panel) {
                panel.classList.toggle('show');
            }
        }
        
        // 移动端列表切换 - 展开/收起选择器面板
        function toggleMobileList() {
            const panel = document.getElementById('provinceData');
            const listBtn = document.getElementById('mobileListBtn');

            if (panel) {
                if (panel.classList.contains('hide')) {
                    // 当前是收起状态，展开
                    panel.classList.remove('hide');
                    if (listBtn) listBtn.textContent = '🗺️';
                } else {
                    // 当前是展开状态，收起
                    panel.classList.add('hide');
                    if (listBtn) listBtn.textContent = '📍';
                }
            }
        }

        // 关闭移动端选择器
        function closeMobileList() {
            const panel = document.getElementById('provinceData');
            const listBtn = document.getElementById('mobileListBtn');

            if (panel) {
                panel.classList.add('hide');
            }
            if (listBtn) {
                listBtn.textContent = '📍';
            }
        }

        // 在页面加载时为每个下载格式li元素添加点击事件监听器
        window.onload = function() {
            const formatItems = document.querySelectorAll("#formatSelect li");
            formatItems.forEach(item => {
                item.addEventListener('click', function() {
                    // 移除其他li的selected类
                    formatItems.forEach(i => i.classList.remove('selected'));
                    // 为所选的li添加selected类
                    item.classList.add('selected');
                    
                    // 更新批量下载按钮的格式标签
                    const batchFormatLabel = document.getElementById('batchFormatLabel');
                    if (batchFormatLabel) {
                        const formatValue = item.getAttribute('data-value');
                        const formatNames = { shp: 'SHP', gson: 'GeoJSON', kml: 'KML', gpkg: 'GeoPackage', svg: 'SVG' };
                        batchFormatLabel.textContent = formatNames[formatValue] || formatValue.toUpperCase();
                    }
                });
            });
            
        }
        //每个li元素的a标签添加点击事件监听器
        async function downloadData(format) {
            selectedFormat = format;
            // 优先使用编码，确保所有下载都使用行政编码
            id = dataCode || SHENG_datacode;
            // 只有在没有编码时才使用地名
            if (!id && address) {
                id = encodeURIComponent(address);
            }
            // 获取当前选择的年份
            const yearSelect = document.getElementById('year');
            const year = yearSelect ? yearSelect.value.replace('年', '') : '2023';
            downloadUrl = `/downloadVector/${id}?format=${selectedFormat}&year=${year}`;
            
            console.log('下载参数 - id:', id, 'year:', year, 'format:', selectedFormat);

            // 检查下载状态
            try {
                const statusResponse = await fetch('/checkDownloadStatus');
                const status = await statusResponse.json();

                // 如果被封禁
                if (status.isBanned) {
                    const banEndTime = new Date(status.banEndTime);
                    const now = new Date();
                    const remainingMinutes = Math.ceil((banEndTime - now) / 60000);
                    document.getElementById('banCountdown').textContent = `解封时间：${remainingMinutes}分钟后`;
                    showBanModal();
                    return;
                }

                // 如果需要密码验证
                if (status.needPassword) {
                    showPasswordModal();
                    return;
                }

                // 正常下载
                window.location.href = downloadUrl;
            } catch (error) {
                console.error('检查下载状态失败:', error);
                window.location.href = downloadUrl;
            }
        }


        function showPasswordModal() {
            const modal = document.getElementById('passwordModal');
            modal.style.display = 'flex';
        }

        function hidePasswordModal() {
            const modal = document.getElementById('passwordModal');
            modal.style.display = 'none';
            document.getElementById('passwordInput').value = '';
        }

        function showBanModal() {
            const modal = document.getElementById('banModal');
            modal.style.display = 'flex';
        }

        function hideBanModal() {
            const modal = document.getElementById('banModal');
            modal.style.display = 'none';
        }

        // 提交密码验证
        async function submitPassword() {
            const password = document.getElementById('passwordInput').value;
            if (!password) {
                alert('请输入密码');
                return;
            }

            try {
                const response = await fetch('/verifyPassword', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ password: password })
                });
                const data = await response.json();

                if (data.success) {
                    hidePasswordModal();
                    // 密码验证成功，重新下载
                    if (downloadUrl) {
                        window.location.href = downloadUrl;
                    }
                } else {
                    alert(data.message);
                }
            } catch (error) {
                console.error('密码验证失败:', error);
