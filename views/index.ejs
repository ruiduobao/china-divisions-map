                if (result.status === 'success') {
                    const { code, name, shengCode, shiCode, filepath } = result.data;
                    
                    // 显示县级边界
                    loadGeoJSONfromPath(filepath);
                    
                    // 更新全局变量
                    dataCode = code;
                    address = null;
                    
                    // 显示下载按钮
                    checkAndShowDownloadButton(code);
                    
                    // 更新选中信息
                    document.getElementById('selectedName').textContent = name;
                    document.getElementById('selectedCode').textContent = `(${code})`;
                    
                    // 获取省份名称（从编码映射）
                    const provinceNames = {
                        '11': '北京市', '12': '天津市', '13': '河北省', '14': '山西省',
                        '15': '内蒙古自治区', '21': '辽宁省', '22': '吉林省', '23': '黑龙江省',
                        '31': '上海市', '32': '江苏省', '33': '浙江省', '34': '安徽省',
