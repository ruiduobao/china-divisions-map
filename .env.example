# ===================
# 应用配置
# ===================

# 服务器端口
PORT=3003
NODE_ENV=production

# ===================
# 数据库配置 (PostgreSQL)
# ===================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shengshixian
DB_USER=ruiduobao
DB_PASSWORD=

# 连接池配置
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=2
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# ===================
# Redis 配置
# ===================
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# ===================
# 高德地图 API
# ===================
GAODE_API_KEY=
GAODE_GEOCODE_KEY=

# ===================
# 认证密码（下载验证）
# ===================
AUTH_PASSWORD=55555

# ===================
# 缓存配置
# ===================
CACHE_EXPIRY_DAYS=90
TREE_CACHE_TTL=86400000
TREE_CACHE_MAX_SIZE=500
TREE_CACHE_MAX_MEMORY_MB=200

# ===================
# 下载限制
# ===================
DOWNLOAD_LIMIT=200000000
BAN_DURATION_MINUTES=30

# ===================
# 村级数据配置
# ===================
ENABLE_VILLAGE_POLYGON=false
VILLAGE_LOAD_MODE=point
VILLAGE_DOWNLOAD_MODE=point_plus_xian
VECTORDATA_MAX_FILES=50000
VECTORDATA_MAX_SIZE_MB=1500
