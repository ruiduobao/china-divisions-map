# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shengshixian
DB_USER=your_username
DB_PASSWORD=your_password

# 数据库连接池配置
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=2
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Redis配置
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# 高德地图API Key
GAODE_API_KEY=your_gaode_api_key
GAODE_GEOCODE_KEY=your_gaode_geocode_key

# 验证密码
AUTH_PASSWORD=your_password

# 服务器配置
PORT=3003
NODE_ENV=production

# 缓存配置
CACHE_EXPIRY_DAYS=90
TREE_CACHE_TTL=86400000
TREE_CACHE_MAX_SIZE=500
TREE_CACHE_MAX_MEMORY_MB=200

# 下载限制
DOWNLOAD_LIMIT=200000000
BAN_DURATION_MINUTES=30